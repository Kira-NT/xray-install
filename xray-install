XRAY_CORE_URL_TEMPLATE="https://github.com/XTLS/Xray-core/releases/latest/download/Xray-%s.zip"
GEOIP_URL_CN="https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat"
GEOSITE_URL_CN="https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat"
GEOIP_URL_IR="https://github.com/Chocolate4U/Iran-v2ray-rules/releases/latest/download/geoip.dat"
GEOSITE_URL_IR="https://github.com/Chocolate4U/Iran-v2ray-rules/releases/latest/download/geosite.dat"
GEOIP_URL_IR_LITE="https://github.com/Chocolate4U/Iran-v2ray-rules/releases/latest/download/geoip-lite.dat"
GEOSITE_URL_IR_LITE="https://github.com/Chocolate4U/Iran-v2ray-rules/releases/latest/download/geosite-lite.dat"
GEOIP_URL_RU="https://github.com/runetfreedom/russia-blocked-geoip/releases/latest/download/geoip.dat"
GEOSITE_URL_RU="https://github.com/runetfreedom/russia-blocked-geosite/releases/latest/download/geosite.dat"
GEOIP_URL_RU_LITE="https://github.com/runetfreedom/russia-blocked-geoip/releases/latest/download/geoip-ru-only.dat"
GEOSITE_URL_RU_LITE="https://github.com/runetfreedom/russia-blocked-geosite/releases/latest/download/geosite-ru-only.dat"

#################################################
# Formats and prints the provided error message.
# Arguments:
#   $1. The error message to format and print.
# Outputs:
#   Writes the formatted error message to stderr.
# Returns:
#   Always returns 1.
#################################################
error() {
  echo "${0}: ${1}" >& 2
  return 1
}

#################################################
# Formats and prints the provided error message,
# displays the help page, and terminates the
# process.
# Arguments:
#   $1. The error message to format and print.
# Outputs:
#   Writes the formatted error message to stderr.
# Returns:
#   Never returns (exits with a status of 1).
#################################################
fatal_error() {
  error "${1}"
  help >& 2
  exit 1
}

#################################################
# Checks if the specified command exists.
# Arguments:
#   $1. The command to check.
# Returns:
#   0 if the specified command exists;
#   otherwise, a non-zero status.
#################################################
command_exists() {
  command -v "${1}" > /dev/null 2>& 1
}

#################################################
# Asserts that a command exists, otherwise exits.
# Arguments:
#   $1. The command to check.
# Outputs:
#   Writes an error message to stderr if missing.
# Returns:
#   0 if the specified command exists;
#   otherwise, never returns.
#################################################
assert_command_exists() {
  command_exists "${1}" && return
  echo "${1}: command not found: install it using your package manager" >& 2
  exit 1
}

#################################################
# Downloads a file.
# Arguments:
#   $1. The URL of the file to download.
#   $2. The destination of the downloaded file.
#       If not provided, the file will be written
#       to stdout.
# Returns:
#   0 if the operation succeeds;
#   otherwise, a non-zero status.
#################################################
download() {
  curl -x "${PROXY}" -fsSLRH "Cache-Control: no-cache" -o "${2}" "${1}" ||
  error "failed to download '${1}'; please check your network and try again"
}

#################################################
# Downloads a file and verifies its integrity.
# Arguments:
#   $1. The URL of the file to download.
#   $2. The destination of the downloaded file.
#       If not provided, the file will be written
#       to stdout.
# Returns:
#   0 if the file is successfully downloaded and
#   the checksum verification passes;
#   otherwise, a non-zero status.
#################################################
download_and_verify() {
  local dir_tmp="$(mktemp -d)"
  local file_tmp="${dir_tmp}/$(basename "${2}")"
  local exit_code=1

  if download "${1}" "${file_tmp}"; then
    local file_hash=$(sha256sum "${file_tmp}" | sed 's/ .*//')
    local expected_file_hash=$( { download "${1}.sha256sum" "-" || download "${1}.dgst" "-" || echo "${file_hash}"; } | sed 's/SHA2-256= *//;/.*=/d;s/ .*//')
    [ "${file_hash}" = "${expected_file_hash}" ] && exit_code=0 || error "'${1}' did not match provided hash"

    case "${1}" in *.zip) case "${2}" in *.zip);; *)
      local current_dir="${PWD}"
      cd "${dir_tmp}" && mv -f "${file_tmp}" "${file_tmp}.zip" &&
      unzip -q "${file_tmp}.zip" "$(basename "${2}")" &&
      file_hash=$(sha256sum "${file_tmp}" | sed 's/ .*//')
      cd "${current_dir}"
    ;;esac;;esac

    [ -f "${2}" ] && [ "${file_hash}" = "$(sha256sum "${2}" | sed 's/ .*//')" ] && exit_code=1 && error "'${2}' already exists; skipping"
  fi

  if [ $exit_code -eq 0 ]; then
    local file_mode=644
    [ -x "${file_tmp}" ] && file_mode=755

    install -m 755 -d "$(dirname "${2}")"
    install -vm $file_mode "${file_tmp}" "${2}"
  fi

  rm -r "${dir_tmp}"
  return $exit_code
}

#################################################
# Prints the current OS and CPU architecture.
# Outputs:
#   Writes the OS identifier and CPU architecture
#   using the '<os>-<arch>' format to stdout.
#################################################
get_os() {
  case "$(uname -s)" in
    Linux) printf linux ;;
    Darwin) printf macos ;;
    FreeBSD) printf freebsd ;;
    OpenBSD) printf openbsd ;;
    CYGWIN*|MINGW*|MSYS*) printf windows ;;
    *) printf unknown ;;
  esac
  printf -
  case "$(uname -m)" in
    x86_64|amd64) printf 64 ;;
    i386|i686) printf 32 ;;
    aarch64|armv8|arm64) printf arm64-v8a ;;
    armv5*) printf arm32-v5 ;;
    armv6l) printf arm32-v6 ;;
    armv7*) printf arm32-v7a ;;
    mips64) printf mips64 ;;
    mips64le) printf mips64le ;;
    mips) printf mips32 ;;
    mipsle) printf mips32le ;;
    ppc64) printf ppc64 ;;
    ppc64le) printf ppc64le ;;
    riscv64) printf riscv64 ;;
    s390x) printf s390x ;;
    loongarch64) printf loong64 ;;
    *) printf unknown ;;
  esac
}

