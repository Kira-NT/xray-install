#################################################
# Formats a systemd service unit for the xray
# executable.
# Arguments:
#   $1. The user under which the service runs.
#   $2. The GID under which the service runs.
#   $3. The wrapper command, if any.
#   $4. The main executable to run.
#   $5. The configuration file path.
#   $6. The XRAY_LOCATION_ASSET path.
#   $7. The transparent proxy port value.
# Outputs:
#   Writes a complete systemd service unit file
#   to stdout.
#################################################
format_autorun_service() {
  echo '[Unit]'
  echo 'Documentation=https://xtls.github.io/en/'
  echo 'After=network.target nss-lookup.target'
  echo
  echo '[Service]'
  if [ -n "${1}" ]; then
    echo 'User='"${1}"
    echo 'CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE'
    echo 'AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE'
  fi
  echo 'NoNewPrivileges=true'
  echo 'ExecStart='"${3:+"\"${3}\" "}"'"'"${4}"'" run -c "'"${5}"'"'
  if [ -n "${3}" ]; then
    echo 'Environment=XRAY_GID='"${2}"
    echo 'Environment=XRAY_TPROXY_PORT='"${7}"
  fi
  echo 'Environment=XRAY_LOCATION_ASSET='"${6}"
  echo 'Restart=on-failure'
  echo 'RestartPreventExitStatus=23'
  echo 'LimitNPROC=10000'
  echo 'LimitNOFILE=1000000'
  echo 'RuntimeDirectory=xray'
  echo 'RuntimeDirectoryMode=0755'
  echo
  echo '[Install]'
  if [ -n "${1}" ]; then
    echo 'WantedBy=multi-user.target'
  else
    echo 'WantedBy=default.target'
  fi
}

#################################################
# Formats a systemd oneshot service unit.
# Arguments:
#   $1. The command to execute (ExecStart).
# Outputs:
#   Prints the formatted unit to stdout.
#################################################
format_oneshot_service() {
  echo '[Service]'
  echo 'Type=oneshot'
  echo 'ExecStart='"${1}"
}

#################################################
# Formats a systemd timer unit.
# Arguments:
#   $1. The OnCalendar schedule expression.
# Outputs:
#   Prints the formatted unit to stdout.
#################################################
format_timer_service() {
  echo '[Timer]'
  echo 'OnCalendar='"${1}"
  echo 'RandomizedDelaySec=1h'
  echo 'Persistent=true'
  echo
  echo '[Install]'
  echo 'WantedBy=timers.target'
}

#################################################
# Formats a polkit rule allowing a group
# to manage a specific systemd unit.
# Arguments:
#   $1. The systemd unit name.
#   $2. The group name.
# Outputs:
#   Prints a JavaScript polkit rule to stdout.
#################################################
format_polkit_policy() {
  echo 'polkit.addRule(function(action, subject) {'
  echo '    if (action.id == "org.freedesktop.systemd1.manage-units" &&'
  echo '        action.lookup("unit") == "'"${1}"'" &&'
  echo '        subject.isInGroup("'"${2}"'")) {'
  echo '        return polkit.Result.YES;'
  echo '    }'
  echo '});'
}

#################################################
# Formats a NetworkManager dispatcher script that
# restarts or reloads a systemd unit on interface
# state changes.
# Arguments:
#   $1. The systemd unit name.
#   $2. The username to run systemctl under.
# Outputs:
#   Prints a POSIX shell script to stdout.
#################################################
format_dispatcher_script() {
  echo '#!/bin/sh'
  echo '[ "${2}" = "up" -o "${2}" = "down" ] &&'
  echo 'grep -sqE "type=(eth|wifi)" "${CONNECTION_FILENAME}" &&'
  echo "${2:+"sudo -u '${2}' "}"'/bin/systemctl '"${2:+"--user "}"'try-reload-or-restart "'"${1}"'" || :'
}

#################################################
# Formats a transparent proxy-aware wrapper for
# the xray executable.
# Outputs:
#   Prints the formatted shell script to stdout.
#################################################
format_tproxy_script() {
  echo '#!/bin/sh'
  echo
  echo 'XRAY_GID=${XRAY_GID:-"$(id -g xray)"}'
  echo 'XRAY_GID=${XRAY_GID:-1000}'
  echo 'XRAY_PID=0'
  echo 'XRAY_STOP='
  echo 'XRAY_STATUS=0'
  echo 'XRAY_SUBNETS=""'
  echo 'XRAY_GATEWAY_SUBNET=""'
  echo 'XRAY6_SUBNETS=""'
  echo 'XRAY6_GATEWAY_SUBNET=""'
  echo 'XRAY_TPROXY_PORT=${XRAY_TPROXY_PORT:-10000}'
  echo
  echo 'command_exists() {'
  echo '  command -v "${1}" > /dev/null 2>& 1'
  echo '}'
  echo
  echo 'terminate_or_kill() {'
  echo '  local attempt=0'
  echo '  kill -TERM $XRAY_PID'
  echo '  while ps -o pid= -p $XRAY_PID > /dev/null && [ $attempt -lt 50 ]; do'
  echo '    sleep 0.05'
  echo '    attempt=$(($attempt + 1))'
  echo '  done'
  echo '  [ $attempt -ge 50 ] && kill -KILL $XRAY_PID'
  echo '}'
  echo
  echo 'configure_iptables() {'
  echo '  command_exists ip && command_exists iptables || return'
  echo
  echo '  local action="D"'
  echo '  local subnet=""'
  echo '  if [ "${1}" = "add" ] || [ -z "${XRAY_SUBNETS}" ]; then'
  echo '    XRAY_SUBNETS=$(ip address | awk "/inet /{print \$2}" 2> /dev/null)'
  echo '    XRAY_GATEWAY_SUBNET=$(ip -o -f inet addr show dev "$(ip route show default | awk "{print \$5}")" 2> /dev/null | awk "{print \$4}")'
  echo '  fi'
  echo '  [ -z "${XRAY_SUBNETS}" ] && return'
  echo
  echo '  ip rule "${1}" fwmark 1 table 100'
  echo '  ip route "${1}" local 0.0.0.0/0 dev lo table 100'
  echo '  if [ "${1}" = "add" ]; then'
  echo '    action="A"'
  echo '    iptables -t mangle -N XRAY'
  echo '    iptables -t mangle -N XRAY_MASK'
  echo '  fi'
  echo
  echo '  for subnet in $XRAY_SUBNETS; do iptables -t mangle -$action XRAY -d $subnet -j RETURN; done'
  echo '  iptables -t mangle -$action XRAY -d 224.0.0.0/3 -j RETURN'
  echo '  [ -n "${XRAY_GATEWAY_SUBNET}" ] && iptables -t mangle -$action XRAY ! -s $XRAY_GATEWAY_SUBNET -j RETURN'
  echo '  iptables -t mangle -$action XRAY -p tcp -j TPROXY --on-port "${XRAY_TPROXY_PORT}" --tproxy-mark 1'
  echo '  iptables -t mangle -$action XRAY -p udp -j TPROXY --on-port "${XRAY_TPROXY_PORT}" --tproxy-mark 1'
  echo '  iptables -t mangle -$action PREROUTING -j XRAY'
  echo '  iptables -t mangle -$action XRAY_MASK -m owner --gid-owner "${XRAY_GID}" -j RETURN'
  echo '  for subnet in $XRAY_SUBNETS; do iptables -t mangle -$action XRAY_MASK -d $subnet -j RETURN; done'
  echo '  iptables -t mangle -$action XRAY_MASK -d 224.0.0.0/3 -j RETURN'
  echo '  iptables -t mangle -$action XRAY_MASK -j MARK --set-mark 1'
  echo '  iptables -t mangle -$action OUTPUT -p tcp -j XRAY_MASK'
  echo '  iptables -t mangle -$action OUTPUT -p udp -j XRAY_MASK'
  echo
  echo '  if [ "${1}" != "add" ]; then'
  echo '    iptables -t mangle -X XRAY_MASK'
  echo '    iptables -t mangle -X XRAY'
  echo '  fi'
  echo '}'
  echo
  echo 'configure_ip6tables() {'
  echo '  command_exists ip && command_exists ip6tables || return'
  echo
  echo '  local action="D"'
  echo '  local subnet=""'
  echo '  if [ "${1}" = "add" ] || [ -z "${XRAY6_SUBNETS}" ]; then'
  echo '    XRAY6_SUBNETS=$(ip address | awk "/inet6 /{print \$2}" 2> /dev/null)'
  echo '    XRAY6_GATEWAY_SUBNET=$(ip -o -f inet6 addr show dev "$(ip -6 route show default | awk "{print \$5}")" 2> /dev/null | awk "{print \$4}")'
  echo '  fi'
  echo '  [ -z "${XRAY6_SUBNETS}" ] && return'
  echo
  echo '  ip -6 rule "${1}" fwmark 1 table 106'
  echo '  ip -6 route "${1}" local ::/0 dev lo table 106'
  echo '  if [ "${1}" = "add" ]; then'
  echo '    action="A"'
  echo '    ip6tables -t mangle -N XRAY6'
  echo '    ip6tables -t mangle -N XRAY6_MASK'
  echo '  fi'
  echo
  echo '  for subnet in $XRAY6_SUBNETS; do ip6tables -t mangle -$action XRAY6 -d $subnet -j RETURN; done'
  echo '  [ -n "${XRAY6_GATEWAY_SUBNET}" ] && ip6tables -t mangle -$action XRAY6 ! -s $XRAY6_GATEWAY_SUBNET -j RETURN'
  echo '  ip6tables -t mangle -$action XRAY6 -p udp -j TPROXY --on-port "${XRAY_TPROXY_PORT}" --tproxy-mark 1'
  echo '  ip6tables -t mangle -$action XRAY6 -p tcp -j TPROXY --on-port "${XRAY_TPROXY_PORT}" --tproxy-mark 1'
  echo '  ip6tables -t mangle -$action PREROUTING -j XRAY6'
  echo '  ip6tables -t mangle -$action XRAY6_MASK -m owner --gid-owner "${XRAY_GID}" -j RETURN'
  echo '  for subnet in $XRAY6_SUBNETS; do ip6tables -t mangle -$action XRAY6_MASK -d $subnet -j RETURN; done'
  echo '  ip6tables -t mangle -$action XRAY6_MASK -j MARK --set-mark 1'
  echo '  ip6tables -t mangle -$action OUTPUT -p tcp -j XRAY6_MASK'
  echo '  ip6tables -t mangle -$action OUTPUT -p udp -j XRAY6_MASK'
  echo
  echo '  if [ "${1}" != "add" ]; then'
  echo '    ip6tables -t mangle -X XRAY6_MASK'
  echo '    ip6tables -t mangle -X XRAY6'
  echo '  fi'
  echo '}'
  echo
  echo 'main() {'
  echo '  trap terminate_or_kill USR1'
  echo '  trap "XRAY_STOP=1; terminate_or_kill" TERM INT QUIT HUP'
  echo '  while [ -z "${XRAY_STOP}" ] && [ $XRAY_STATUS -eq 0 ]; do'
  echo '    "$@" &'
  echo '    XRAY_PID=$!'
  echo '    configure_iptables add'
  echo '    configure_ip6tables add'
  echo '    wait $XRAY_PID'
  echo '    XRAY_STATUS=$?'
  echo '    configure_iptables delete'
  echo '    configure_ip6tables delete'
  echo '  done'
  echo '  return $XRAY_STATUS'
  echo '}'
  echo
  echo 'main "$@"'
}

#################################################
# Creates a file with given permissions using the
# output of a command.
# Arguments:
#   $1. The target file path.
#   $2. The chmod value.
#   ... The command to execute, whose stdout
#       becomes the file content.
#################################################
create_file() {
  local target_filename="${1}"
  local target_chmod="${2}"
  shift 2

  mkdir -m 755 -p "$(dirname "${target_filename}")" &&
  "$@" > "${target_filename}" && chmod "${target_chmod}" "${target_filename}"
}

