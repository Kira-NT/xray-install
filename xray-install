#################################################
# The main entry point for the script.
# Arguments:
#   ... A list of the command line arguments.
#################################################
main() {
  local xray_url=$(printf "${XRAY_CORE_URL_TEMPLATE}" "$(get_os)")
  local xray_filename=""
  local xray_tproxy_filename=""
  local dispatcher_filename=""
  local polkit_policy_filename=""
  local config_filename=""
  local geoip_url="${GEOIP_URL_CN}"
  local geosite_url="${GEOSITE_URL_CN}"
  local geodata_directory=""
  local geoip_filename=""
  local geosite_filename=""
  local log_directory=""
  local access_log_filename=""
  local error_log_filename=""
  local update_timer=""
  local update_command=""
  local systemd_directory=""
  local systemd_service_filename=""
  local systemd_update_service_filename=""
  local systemd_update_timer_filename=""
  local systemd_is_user=""
  local systemd_user=""
  local systemd_user_gid=
  local systemd_user_flags=""
  local updated=0
  local tproxy_port=
  local autorun=
  local uninstall=

  # Parse the arguments and options.
  while [ -n "${1}" ]; do
    case "${1}" in
      -h|--help) help; exit 0 ;;
      -p|--proxy) PROXY="${2}"; shift ;;
      -x|--xray-url) xray_url="${2}"; shift ;;
      -b|--binary|--xray-path) xray_filename="${2}"; shift ;;
      -i|--geoip-url) geoip_url="${2}"; shift ;;
      -s|--geosite-url) geosite_url="${2}"; shift ;;
      -t|--geodata-type) case "${2}" in
        none) geoip_url=""; geosite_url="" ;;
        cn) geoip_url="${GEOIP_URL_CN}"; geosite_url="${GEOSITE_URL_CN}" ;;
        ir) geoip_url="${GEOIP_URL_IR}"; geosite_url="${GEOSITE_URL_IR}" ;;
        ir-lite) geoip_url="${GEOIP_URL_IR_LITE}"; geosite_url="${GEOSITE_URL_IR_LITE}" ;;
        ru) geoip_url="${GEOIP_URL_RU}"; geosite_url="${GEOSITE_URL_RU}" ;;
        ru-lite) geoip_url="${GEOIP_URL_RU_LITE}"; geosite_url="${GEOSITE_URL_RU_LITE}" ;;
        *) fatal_error "invalid geodata type: ${2}" ;; esac; shift ;;
      -d|--data-path|--geodata-path) geodata_directory="${2}"; shift ;;
      -l|--log-path) log_directory="${2}"; shift ;;
      -c|--config-path) config_filename="${2}"; shift ;;
      -P|--tproxy-port) tproxy_port="${2}"; shift ;;
      -a|--autorun) autorun=1 ;;
      -u|--update) update_timer="${2}"; shift ;;
      -r|--reload-command) update_command="${2}"; shift ;;
      --uninstall) uninstall=1 ;;
      -*) fatal_error "invalid option: ${1}" ;;
      *) fatal_error "invalid argument: ${1}" ;;
    esac
    shift 2> /dev/null || fatal_error "missing operand"
  done

  # Ensure that the script's prerequisites are met.
  [ -n "${xray_url}" -o -n "${geoip_url}" -o -n "${geosite_url}" ] && assert_command_exists curl
  [ -n "${xray_url}" ] && assert_command_exists unzip
  [ -n "${autorun}" -o -n "${update_timer}" ] && assert_command_exists systemctl
  [ -n "${tproxy_port}" ] && assert_command_exists ip && assert_command_exists iptables

  # Resolve paths based on the provided arguments.
  if [ "${EUID:-"$(id -u)"}" -eq 0 ]; then
    xray_filename=$(realpath -m "${xray_filename:-"/usr/local/bin/xray"}")
    config_filename=$(realpath -m "${config_filename:-"/usr/local/etc/xray/config.json"}")
    geodata_directory=$(realpath -m "${geodata_directory:-"/usr/local/share/xray"}")
    log_directory=$(realpath -m "${log_directory:-"/var/log/xray"}")
    systemd_directory="/etc/systemd/system"
    systemd_user="xray"
    systemd_user_flags=${tproxy_port:+"-ou 0"}
    systemd_user_flags=${systemd_user_flags:-"-r"}
    xray_tproxy_filename=${tproxy_port:+"$(dirname "${xray_filename}")/xray-tproxy"}
    polkit_policy_filename=${autorun:+"/etc/polkit-1/rules.d/99-$(basename "${xray_filename}").rules"}
    dispatcher_filename=${autorun:+"/etc/NetworkManager/dispatcher.d/99-$(basename "${xray_filename}")-reload"}
  else
    xray_filename=$(realpath -m "${xray_filename:-"${HOME}/.local/bin/xray"}")
    config_filename=$(realpath -m "${config_filename:-"${HOME}/.config/xray/config.json"}")
    geodata_directory=$(realpath -m "${geodata_directory:-"${HOME}/.local/share/xray"}")
    log_directory=$(realpath -m "${log_directory:-"${HOME}/.local/state/xray"}")
    systemd_directory="${HOME}/.config/systemd/user"
    systemd_is_user="--user"
    [ -z "${tproxy_port}" ] || error "cannot configure transparent proxy: Permission denied" || exit
    dispatcher_filename=${autorun:+"/etc/NetworkManager/dispatcher.d/99-$(basename "${xray_filename}")-reload-$(id -un)"}
  fi
  geoip_filename=${geoip_url:+"${geodata_directory}/geoip.dat"}
  geosite_filename=${geosite_url:+"${geodata_directory}/geosite.dat"}
  systemd_service_filename=${autorun:+"${systemd_directory}/xray.service"}
  systemd_update_service_filename=${update_timer:+"${systemd_directory}/xray-update.service"}
  systemd_update_timer_filename=${update_timer:+"${systemd_directory}/xray-update.timer"}
  access_log_filename="${log_directory}/access.log"
  error_log_filename="${log_directory}/error.log"
  update_command=${update_command:-"${systemd_service_filename:+"/bin/systemctl $systemd_is_user try-reload-or-restart '$(basename "${systemd_service_filename}")'"}"}

  # If the user has requested uninstallation, undo everything we did.
  if [ -n "${uninstall}" ]; then
    systemctl ${systemd_is_user} disable --now "$(basename "${systemd_service_filename}")" 2> /dev/null
    systemctl ${systemd_is_user} disable --now "$(basename "${systemd_update_timer_filename}")" 2> /dev/null
    systemctl ${systemd_is_user} disable --now "$(basename "${systemd_update_service_filename}")" 2> /dev/null

    rm -fv "${xray_filename}" "${xray_tproxy_filename}" "${config_filename}" \
      "${access_log_filename}" "${error_log_filename}" \
      "${geoip_filename}" "${geosite_filename}" "${dispatcher_filename}" "${polkit_policy_filename}" \
      "${systemd_service_filename}" "${systemd_update_timer_filename}" "${systemd_update_service_filename}" 2> /dev/null

    [ -f "${dispatcher_filename}" ] && sudo rm -fv "${dispatcher_filename}"
    [ -x "${0}" ] && command_exists semanage && sudo semanage fcontext -d -t bin_t "$(realpath "${0}")"
    [ -n "${dispatcher_filename}" ] && command_exists semanage && sudo semanage fcontext -d -t bin_t "${dispatcher_filename}"
    [ -n "${xray_filename}" ] && command_exists semanage && sudo semanage fcontext -d -t bin_t "${xray_filename}"
    [ -n "${xray_tproxy_filename}" ] && command_exists semanage && sudo semanage fcontext -d -t bin_t "${xray_tproxy_filename}"

    [ "$(basename "${log_directory}")" = "xray" ] && rm -rf "${log_directory}" 2> /dev/null
    [ "$(basename "${geodata_directory}")" = "xray" ] && rm -rf "${geodata_directory}" 2> /dev/null
    [ "$(basename "$(dirname "${config_filename}")")" = "xray" ] && rm -rf "$(dirname "${config_filename}")" 2> /dev/null

    [ -n "${systemd_user}" ] && userdel -rf "${systemd_user}" 2> /dev/null
    [ -n "${systemd_user}" ] && groupdel -f "${systemd_user}" 2> /dev/null
    return 0
  fi

  echo "=== Xray Files ==="
  [ -n "${xray_filename}" ] && echo "${xray_filename}"
  [ -n "${xray_tproxy_filename}" ] && echo "${xray_tproxy_filename}"
  [ -n "${geoip_filename}" ] && echo "${geoip_filename}"
  [ -n "${geosite_filename}" ] && echo "${geosite_filename}"
  [ -n "${config_filename}" ] && echo "${config_filename}"
  [ -n "${access_log_filename}" ] && echo "${access_log_filename}"
  [ -n "${error_log_filename}" ] && echo "${error_log_filename}"
  [ -n "${systemd_service_filename}" ] && echo "${systemd_service_filename}"
  [ -n "${systemd_update_service_filename}" ] && echo "${systemd_update_service_filename}"
  [ -n "${systemd_update_timer_filename}" ] && echo "${systemd_update_timer_filename}"
  [ -n "${dispatcher_filename}" ] && echo "${dispatcher_filename}"
  [ -n "${polkit_policy_filename}" ] && echo "${polkit_policy_filename}"
  echo "=================="

  # Download/create all required files.
  [ -z "${xray_url}" ] && error "missing url: skipping xray update"
  [ -z "${geoip_url}" ] && error "missing url: skipping geoip.dat update"
  [ -z "${geosite_url}" ] && error "missing url: skipping geosite.dat update"
  [ -n "${xray_url}" ] && download_and_verify "${xray_url}" "${xray_filename}" && updated=$(($updated + 1))
  [ -n "${geoip_url}" ] && download_and_verify "${geoip_url}" "${geoip_filename}" && updated=$(($updated + 1))
  [ -n "${geosite_url}" ] && download_and_verify "${geosite_url}" "${geosite_filename}" && updated=$(($updated + 1))
  [ -n "${log_directory}" ] && create_file "${access_log_filename}" 620 printf ""
  [ -n "${log_directory}" ] && create_file "${error_log_filename}" 620 printf ""
  [ -n "${config_filename}" ] && [ ! -f "${config_filename}" ] && create_file "${config_filename}" 640 format_config "${access_log_filename}" "${error_log_filename}" "${tproxy_port}"
  [ -n "${xray_tproxy_filename}" ] && create_file "${xray_tproxy_filename}" 755 format_tproxy_script

  # Create a user to run Xray as.
  if [ -n "${systemd_user}" ]; then
    id -u "${systemd_user}" > /dev/null 2>& 1 || useradd -MUs /usr/sbin/nologin ${systemd_user_flags} "${systemd_user}" &&
    systemd_user_gid=$(id -g "${systemd_user}") &&
    chown -R ":${systemd_user}" "${config_filename}" "${log_directory}" "${geodata_directory}"
  fi

  # Create a systemd service for managing Xray.
  if [ -n "${autorun}" ]; then
    if [ "${EUID:-"$(id -u)"}" -eq 0 ]; then
      [ -n "${dispatcher_filename}" ] && create_file "${dispatcher_filename}" 500 format_dispatcher_script "$(basename "${systemd_service_filename}")"
      [ -n "${polkit_policy_filename}" ] && create_file "${polkit_policy_filename}" 755 format_polkit_policy "$(basename "${systemd_service_filename}")" "${systemd_user}"
    elif [ -n "${dispatcher_filename}" ]; then
      sudo mkdir -p -m 755 "$(dirname "${dispatcher_filename}")" &&
      format_dispatcher_script "$(basename "${systemd_service_filename}")" "$(id -un)" | sudo tee "${dispatcher_filename}" > /dev/null &&
      sudo chmod 500 "${dispatcher_filename}"
    fi

    command_exists semanage && sudo semanage fcontext -a -t bin_t "${xray_filename}"
    [ -n "${dispatcher_filename}" ] && command_exists semanage && sudo semanage fcontext -a -t bin_t "${dispatcher_filename}"
    [ -n "${xray_tproxy_filename}" ] && command_exists semanage && sudo semanage fcontext -a -t bin_t "${xray_tproxy_filename}"

    create_file "${systemd_service_filename}" 644 format_autorun_service "${systemd_user}" "${systemd_user_gid}" "${xray_tproxy_filename}" "${xray_filename}" "${config_filename}" "${geodata_directory}" "${tproxy_port}" &&
    systemctl ${systemd_is_user} enable "$(basename "${systemd_service_filename}")"
  fi

  # Create a systemd timer to automatically update Xray.
  if [ -n "${update_timer}" ]; then
    local script_filename=$(realpath "${0}")
    local script_exec="\"${script_filename}\" -p \"${PROXY}\" -x \"${xray_url}\" -b \"${xray_filename}\" -i \"${geoip_url}\" -s \"${geosite_url}\" -d \"${geodata_directory}\" -l \"${log_directory}\" -c \"${config_filename}\" -r \"${update_command}\""
    command_exists semanage && sudo semanage fcontext -a -t bin_t "${script_filename}"

    create_file "${systemd_update_service_filename}" 644 format_oneshot_service "${script_exec}" &&
    create_file "${systemd_update_timer_filename}" 644 format_timer_service "${update_timer}" &&
    systemctl ${systemd_is_user} enable --now "$(basename "${systemd_update_timer_filename}")"
  fi

  [ $updated -eq 0 ] || sh -c "${update_command}"
}

main "$@"
